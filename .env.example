# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase configuration for production deployment (Postgres with pgvector, Auth, Storage)
SUPABASE_URL="https://xyzcompany.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Optional swappable external AI provider API key (e.g., OpenAI / Gemini / Cohere)
AI_PROVIDER_API_KEY=""

# RAPIDAPI CONFIGURATION: Used for AI chat, searching PDFs, and grounded answering
# RAPIDAPI_KEY: Your RapidAPI secret key (e.g. from rapidapi.com Developer Dashboard)
RAPIDAPI_KEY=""

# RAPIDAPI_HOST: RapidAPI service host domain
# Common hosts: chatgpt-42.p.rapidapi.com, openai80.p.rapidapi.com, cheapest-gpt-4-turbo-gpt-4-vision-chatgpt.p.rapidapi.com
RAPIDAPI_HOST="chatgpt-42.p.rapidapi.com"

# RAPIDAPI_ENDPOINT: Optional endpoint path (e.g., /conversationWithGPT or /chat/completions)
RAPIDAPI_ENDPOINT="/conversationWithGPT"

# RAPIDAPI_MODEL: Optional model identifier (e.g., gpt-4o-mini, gpt-4, gpt-3.5-turbo)
RAPIDAPI_MODEL="gpt-4o-mini"
